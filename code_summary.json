{
  "project_name": "Repal Equipamentos",
  "project_type": "frontend",
  "framework": "React",
  "language": "TypeScript",
  "build_tool": "Vite",
  "port": 5173,
  "description": "Site institucional da Repal Equipamentos para catálogo de produtos e gestão administrativa",
  "main_features": [
    "Catálogo de produtos com categorias e subcategorias",
    "Sistema de administração para gestão de conteúdo",
    "Integração com WhatsApp para contato",
    "Captura e gerenciamento de leads",
    "Interface responsiva e moderna",
    "Autenticação para área administrativa"
  ],
  "key_pages": [
    {
      "path": "/",
      "component": "Home",
      "description": "Página inicial com produtos em destaque e hero section"
    },
    {
      "path": "/categorias",
      "component": "AllCategories",
      "description": "Listagem de todas as categorias disponíveis"
    },
    {
      "path": "/categoria/:slug",
      "component": "Category",
      "description": "Página de categoria com produtos filtrados"
    },
    {
      "path": "/produto/:slug",
      "component": "ProductDetail",
      "description": "Página de detalhes do produto com galeria e especificações"
    },
    {
      "path": "/admin",
      "component": "Admin",
      "description": "Painel administrativo para gestão de produtos, categorias e leads"
    },
    {
      "path": "/login",
      "component": "Login",
      "description": "Página de login para administradores"
    },
    {
      "path": "/sobre",
      "component": "About",
      "description": "Página institucional sobre a empresa"
    },
    {
      "path": "/contato",
      "component": "Contact",
      "description": "Página de contato com informações e localização"
    }
  ],
  "main_components": [
    "Header - Cabeçalho com navegação e logo",
    "Footer - Rodapé com informações da empresa",
    "ProductCard - Card de produto para listagens",
    "CategoryMenu - Menu de navegação por categorias",
    "WhatsAppButton - Botão de contato via WhatsApp",
    "SearchBar - Barra de busca de produtos",
    "LoadingSpinner - Componente de loading",
    "ContactForm - Formulário de contato",
    "ImageUpload - Upload de imagens para admin",
    "WysiwygEditor - Editor de texto rico"
  ],
  "database_tables": [
    "categories - Categorias principais de produtos",
    "subcategories - Subcategorias dos produtos",
    "products - Produtos do catálogo",
    "product_images - Imagens dos produtos",
    "admin_users - Usuários administrativos",
    "leads - Leads capturados do site",
    "site_settings - Configurações gerais do site"
  ],
  "key_hooks": [
    "useProducts - Gerenciamento de produtos",
    "useCategories - Gerenciamento de categorias",
    "useAuth - Autenticação de usuários",
    "useLeads - Gerenciamento de leads",
    "useSiteSettings - Configurações do site",
    "useFilters - Filtros de produtos",
    "usePagination - Paginação de listagens"
  ],
  "external_integrations": [
    "Supabase - Backend as a Service (database, auth, storage)",
    "WhatsApp - Integração para contato direto",
    "Google Maps - Exibição de localização das lojas"
  ],
  "styling": "TailwindCSS",
  "state_management": "React Query + React Hooks",
  "routing": "React Router v7",
  "icons": "Lucide React",
  "notifications": "Sonner",
  "deployment": "Vercel/Docker",
  "test_scenarios": [
    "Navegação entre páginas principais",
    "Busca e filtro de produtos",
    "Visualização de detalhes do produto",
    "Contato via WhatsApp",
    "Login administrativo",
    "Gestão de produtos no admin",
    "Responsividade em diferentes dispositivos",
    "Performance de carregamento",
    "Funcionalidade de upload de imagens"
  ]
}